rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cho phép người mua (không phải chủ brand) trừ tồn kho khi đặt hàng/đổi điểm,
    // nhưng CHỈ được đổi đúng 2 field stock & weeklyRedeemed, và stock chỉ được giảm.
    function isValidStockDecrement() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['stock', 'weeklyRedeemed'])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.weeklyRedeemed > resource.data.weeklyRedeemed;
    }

    // P0-1: Kiểm tra thay đổi points hợp lệ — chỉ cho phép thay đổi field points,
    // giá trị phải là số nguyên >= 0. Transaction phía client đảm bảo logic nghiệp vụ,
    // rule này đảm bảo client không thể set points về giá trị âm hoặc sửa field khác.
    function isValidPointsUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['points'])
          && request.resource.data.points is number
          && request.resource.data.points >= 0;
    }

    // Hồ sơ người dùng — mỗi người chỉ quản lý hồ sơ của chính mình
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // P0-1: Cho phép update profile thông thường HOẶC chỉ update points (qua transaction)
      allow update: if isSignedIn() && request.auth.uid == userId
                    && (isValidPointsUpdate() || request.resource.data.points == resource.data.points);
      allow delete: if false;
    }

    // Danh sách admin — tạo thủ công trong Firebase Console, KHÔNG cho ghi từ client
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Hồ sơ đăng ký Brand
    match /brands/{brandId} {
      allow read: if true; // đọc công khai (để hiện tên brand, kiểm tra trạng thái)
      allow create: if isSignedIn()
                    && request.auth.uid == brandId
                    && request.resource.data.status == 'pending';
      // Chủ brand được sửa thông tin của mình nhưng KHÔNG được tự đổi trạng thái duyệt.
      // Chỉ admin mới đổi được status (duyệt/từ chối).
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == brandId
                        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Sản phẩm do brand đã duyệt đăng lên
    match /products/{productId} {
      allow read: if true; // cửa hàng công khai, ai cũng xem được

      allow create: if isSignedIn()
                    && request.resource.data.brandId == request.auth.uid
                    && get(/databases/$(database)/documents/brands/$(request.auth.uid)).data.status == 'approved';

      allow update, delete: if isAdmin()
                    || (isSignedIn() && resource.data.brandId == request.auth.uid)
                    || (isSignedIn() && isValidStockDecrement());
    }

    // P0-2: Đơn hàng thật — tạo khi khách mua/đổi điểm sản phẩm brand
    // Brand được cập nhật CHỈ field status (vòng đời đơn hàng), không sửa field khác
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
                    resource.data.buyerId == request.auth.uid ||
                    resource.data.brandId == request.auth.uid ||
                    isAdmin()
                  );
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;

      // P0-2: Cho brand cập nhật chỉ field status theo chuỗi hợp lệ
      allow update: if isSignedIn()
                    && resource.data.brandId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status is string
                    && request.resource.data.status in ['pending', 'confirmed', 'shipping', 'completed', 'cancelled'];
      allow delete: if false;
    }

    // P1-3: Thông báo trong app
    match /notifications/{userId}/items/{notifId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
