rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hằng số — PHẢI khớp với src/lib/points.js ──
    function WELCOME_POINTS() { return 20; }
    function BONUS_VND_PER_POINT() { return 10000; }
    function TRADE_IN_CATEGORIES() { return ['clothes_a', 'clothes_b', 'clothes_c', 'coffee']; }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Đơn hàng orderId được TẠO MỚI trong chính lần ghi này (transaction/batch)
    function isOrderCreatedNow(orderId) {
      return orderId is string
          && !exists(orderPath(orderId))
          && existsAfter(orderPath(orderId));
    }

    // ─────────────────────────────────────────────
    // Điểm xanh — client KHÔNG BAO GIỜ tự đặt số điểm tuỳ ý.
    // Điểm chỉ thay đổi qua 1 trong 4 đường, mỗi đường gắn với 1 chứng từ:
    //   (a) Người dùng đổi điểm lấy sản phẩm → trừ đúng pointsUsed của đơn redeem tạo cùng lúc
    //   (b) Brand hoàn tất đơn mua          → cộng đúng pointsEarned của đơn đó
    //   (c) Brand huỷ đơn đổi điểm           → hoàn đúng pointsUsed của đơn đó
    //   (d) Admin duyệt yêu cầu thu gom      → admin cộng điểm (admin là bên tin cậy)
    // ─────────────────────────────────────────────

    // (a) Trừ điểm khi đổi sản phẩm
    function isRedeemDebit(userId) {
      let oid = request.resource.data.lastOrderId;
      let o = getAfter(orderPath(oid)).data;
      return request.auth.uid == userId
          && changed().hasOnly(['points', 'lastOrderId'])
          && isOrderCreatedNow(oid)
          && o.buyerId == userId
          && o.type == 'redeem'
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && resource.data.points - request.resource.data.points == o.pointsUsed;
    }

    // (b)(c) Brand cộng/hoàn điểm cho người mua khi chuyển đơn sang trạng thái cuối
    function isOrderCredit(userId) {
      let oid = request.resource.data.lastCreditOrderId;
      let before = get(orderPath(oid)).data;
      let after = getAfter(orderPath(oid)).data;
      let delta = request.resource.data.points - resource.data.points;
      return changed().hasOnly(['points', 'lastCreditOrderId'])
          && after.brandId == request.auth.uid
          && after.buyerId == userId
          && before.status != after.status
          && (
            (after.get('type', 'buy') == 'buy' && after.status == 'completed' && delta == after.pointsEarned)
            || (after.get('type', 'buy') == 'redeem' && after.status == 'cancelled' && delta == after.pointsUsed)
          );
    }

    // Sửa hồ sơ thông thường — không được đụng vào điểm và các field chứng từ
    function isProfileOnlyUpdate() {
      return !changed().hasAny(['points', 'lastOrderId', 'lastCreditOrderId', 'createdAt']);
    }

    match /users/{userId} {
      // Chỉ chủ tài khoản và admin được đọc (email, điểm là dữ liệu riêng tư).
      // Brand cộng điểm bằng increment() nên không cần đọc hồ sơ người mua.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'points', 'createdAt'])
                    && request.resource.data.points == WELCOME_POINTS();
      allow update: if isSignedIn() && (
                      (request.auth.uid == userId && isProfileOnlyUpdate())
                      || isRedeemDebit(userId)
                      || isOrderCredit(userId)
                      || (isAdmin()
                          && changed().hasOnly(['points'])
                          && request.resource.data.points is int
                          && request.resource.data.points >= 0)
                    );
      allow delete: if false;
    }

    // Danh sách admin — tạo thủ công trong Firebase Console, KHÔNG cho ghi từ client
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Hồ sơ đăng ký Brand
    // Hồ sơ chứa ownerEmail → chỉ chủ brand và admin được đọc.
    // (Tên brand hiển thị công khai đã được lưu sẵn trong products.brandName.)
    match /brands/{brandId} {
      allow read: if isSignedIn() && (request.auth.uid == brandId || isAdmin());
      allow create: if isSignedIn()
                    && request.auth.uid == brandId
                    && request.resource.data.keys().hasOnly([
                         'brandName', 'description', 'ownerUid', 'ownerEmail', 'status', 'createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerEmail == request.auth.token.email
                    && request.resource.data.status == 'pending';
      // Chủ brand được sửa thông tin nhưng KHÔNG được tự đổi trạng thái duyệt hay chủ sở hữu.
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == brandId
                        && !changed().hasAny(['status', 'ownerUid', 'ownerEmail', 'createdAt']));
      allow delete: if isAdmin();
    }

    // Người mua trừ tồn kho — CHỈ khi tạo đơn hàng cùng lúc, trừ đúng số lượng của đơn
    function isOrderStockDecrement(productId) {
      let oid = request.resource.data.lastOrderId;
      let o = getAfter(orderPath(oid)).data;
      let qty = resource.data.stock - request.resource.data.stock;
      return changed().hasOnly(['stock', 'weeklyRedeemed', 'lastOrderId'])
          && isOrderCreatedNow(oid)
          && o.productId == productId
          && o.buyerId == request.auth.uid
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && qty == o.quantity
          && request.resource.data.weeklyRedeemed == resource.data.get('weeklyRedeemed', 0) + qty;
    }

    // Giá VNĐ, giá điểm, tồn kho phải là số dương hợp lệ — chặn giá điểm âm
    // (đổi sản phẩm giá -1000 điểm sẽ CỘNG điểm cho người đổi).
    function isValidProductData() {
      let p = request.resource.data;
      return p.priceVND is number && p.priceVND > 0 && p.priceVND <= 100000000
          && p.points is int && p.points >= 1
          && p.stock is int && p.stock >= 0;
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.brandId == request.auth.uid
                    && get(/databases/$(database)/documents/brands/$(request.auth.uid)).data.status == 'approved'
                    && isValidProductData();

      allow update: if isSignedIn() && (
                      (resource.data.brandId == request.auth.uid
                        && request.resource.data.brandId == resource.data.brandId
                        && isValidProductData())
                      || isOrderStockDecrement(productId)
                      || isAdmin()
                    );
      allow delete: if isSignedIn() && (resource.data.brandId == request.auth.uid || isAdmin());
    }

    // ── Đơn hàng: giá, điểm và thưởng được đối chiếu với sản phẩm thật ──
    function isValidNewOrder(orderId) {
      let o = request.resource.data;
      let productPath = /databases/$(database)/documents/products/$(o.productId);
      let p = get(productPath).data;
      return o.buyerId == request.auth.uid
          && o.brandId == p.brandId
          // Brand KHÔNG được tự mua/đổi sản phẩm của chính mình (tránh tự cộng điểm)
          && o.buyerId != o.brandId
          && o.status == 'pending'
          && o.quantity is int && o.quantity >= 1 && o.quantity <= 99
          // Tồn kho phải được trừ trong cùng transaction
          && getAfter(productPath).data.lastOrderId == orderId
          && (
            (o.type == 'redeem'
              && o.quantity == 1
              && o.pointsUsed is int && o.pointsUsed >= 1
              && o.pointsUsed == p.points
              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastOrderId == orderId)
            || (o.type == 'buy'
              && o.priceVND is number && o.priceVND > 0
              && o.priceVND == p.priceVND
              && o.totalVND == p.priceVND * o.quantity
              && o.pointsEarned == math.floor(o.totalVND / BONUS_VND_PER_POINT())
              && o.paymentMethod in ['COD', 'VIETQR', 'MOMO']
              && ((o.paymentMethod == 'COD' && o.paymentStatus == 'cod')
                  || (o.paymentMethod != 'COD' && o.paymentStatus == 'unpaid')))
          );
    }

    // Luồng trạng thái hợp lệ — khớp ORDER_STATUS_TRANSITIONS trong BrandDashboard
    function isValidStatusTransition(type, from, to) {
      return from == to
          || (type == 'buy' && (
                (from == 'pending' && to in ['confirmed', 'cancelled'])
                || (from == 'confirmed' && to == 'shipping')
                || (from == 'shipping' && to == 'completed')))
          || (type == 'redeem' && from == 'pending' && to in ['completed', 'cancelled']);
    }

    // paymentStatus chỉ được đi 1 chiều: unpaid → paid
    function isValidPaymentChange() {
      let from = resource.data.get('paymentStatus', null);
      let to = request.resource.data.get('paymentStatus', null);
      return from == to || (from == 'unpaid' && to == 'paid');
    }

    // Đơn chuyển khoản (VietQR/MoMo) chỉ được "Hoàn thành" khi đã xác nhận nhận tiền
    function isPaidIfCompleting() {
      let o = request.resource.data;
      return o.status != 'completed'
          || o.get('type', 'buy') != 'buy'
          || o.get('paymentMethod', 'COD') == 'COD'
          || o.get('paymentStatus', null) == 'paid';
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
                    resource.data.buyerId == request.auth.uid ||
                    resource.data.brandId == request.auth.uid ||
                    isAdmin()
                  );
      allow create: if isSignedIn() && isValidNewOrder(orderId);

      allow update: if isSignedIn()
                    && resource.data.brandId == request.auth.uid
                    && changed().hasOnly(['status', 'paymentStatus'])
                    && isValidStatusTransition(resource.data.get('type', 'buy'), resource.data.status, request.resource.data.status)
                    && isValidPaymentChange()
                    && isPaidIfCompleting();
      allow delete: if false;
    }

    // ── Yêu cầu thu gom (đổi đồ cũ lấy điểm) ──
    // Người dùng chỉ khai báo; điểm chỉ được cộng khi admin/điểm thu gom cân và duyệt.
    match /tradeIns/{tradeInId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                         'userId', 'userName', 'userEmail', 'categoryId', 'declaredWeightKg',
                         'estimatedPoints', 'collectionPoint', 'status', 'createdAt'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.categoryId in TRADE_IN_CATEGORIES()
                    && request.resource.data.declaredWeightKg is number
                    && request.resource.data.declaredWeightKg > 0
                    && request.resource.data.declaredWeightKg <= 50;
      allow update: if isAdmin()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.userId == resource.data.userId
                    && (request.resource.data.status == 'rejected'
                        || (request.resource.data.finalCategoryId in TRADE_IN_CATEGORIES()
                            && request.resource.data.points is int
                            && request.resource.data.points >= 0));
      allow delete: if false;
    }

    // Thông báo trong app
    // Chỉ được gửi khi có quan hệ thật: admin → bất kỳ ai, hoặc người mua ↔ brand
    // của CÙNG một đơn hàng (orderId). Link chỉ được là đường dẫn nội bộ.
    function isValidNotification(userId) {
      let n = request.resource.data;
      return n.keys().hasOnly(['type', 'title', 'message', 'link', 'readAt', 'createdAt', 'fromUid', 'orderId'])
          && n.fromUid == request.auth.uid
          && n.readAt == null
          && n.title is string && n.title.size() <= 120
          && n.message is string && n.message.size() <= 500
          && n.link is string && n.link.matches('^(/[A-Za-z0-9/_-]*)?$');
    }

    function isOrderCounterparty(userId) {
      let n = request.resource.data;
      let o = get(orderPath(n.orderId)).data;
      return n.orderId is string
          && exists(orderPath(n.orderId))
          && ((o.buyerId == request.auth.uid && o.brandId == userId)
              || (o.brandId == request.auth.uid && o.buyerId == userId));
    }

    match /notifications/{userId}/items/{notifId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Người nhận chỉ được đánh dấu đã đọc
      allow update: if isSignedIn() && request.auth.uid == userId
                    && changed().hasOnly(['readAt']);
      allow create: if isSignedIn()
                    && isValidNotification(userId)
                    && (isAdmin() || isOrderCounterparty(userId));
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
