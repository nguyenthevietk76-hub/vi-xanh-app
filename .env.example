VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VietQR — thông tin tài khoản ngân hàng nhận thanh toán (dùng để tạo mã QR chuyển khoản)
# VITE_BANK_ID: mã BIN hoặc tên viết tắt ngân hàng, vd: vietcombank, mbbank, 970436...
#   Tra danh sách tại https://api.vietqr.io/v2/banks
VITE_BANK_ID=
VITE_BANK_ACCOUNT_NO=
VITE_BANK_ACCOUNT_NAME=

# Supabase Storage — lưu ảnh sản phẩm (xem SUPABASE_SETUP.md)
# Dùng anon / publishable key (KHÔNG dùng service_role / secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=product-images
